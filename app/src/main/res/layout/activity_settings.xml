<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- Top Tab Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="@color/white"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/tab_btn_launcher"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Launcher"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_border_rect"
            android:textColor="@color/black"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/tab_btn_lockscreen"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Lock Screen"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@color/white"
            android:textColor="@color/black"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/black"
        android:layout_marginBottom="4dp" />

    <!-- ── Tab 1: Launcher Settings ─────────────────────────────────── -->
    <ScrollView
        android:id="@+id/tab_launcher_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/settings_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/settings_github_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/repo_link"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/settings_rows_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pref_rows"
                android:textSize="14sp"
                android:textColor="@color/black" />

            <SeekBar
                android:id="@+id/settings_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="7"
                android:min="1"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/settings_cols_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pref_cols"
                android:textSize="14sp"
                android:textColor="@color/black" />

            <SeekBar
                android:id="@+id/settings_cols"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="3"
                android:min="1"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/settings_icon_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pref_icon_mode"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:layout_marginBottom="4dp" />

            <RadioGroup
                android:id="@+id/settings_icon_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <RadioButton
                    android:id="@+id/icon_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Text"
                    android:textSize="12sp"
                    android:textColor="@color/black" />

                <RadioButton
                    android:id="@+id/icon_monogram"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mono"
                    android:textSize="12sp"
                    android:textColor="@color/black" />

                <RadioButton
                    android:id="@+id/icon_system"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="System"
                    android:textSize="12sp"
                    android:textColor="@color/black" />

            </RadioGroup>

            <CheckBox
                android:id="@+id/settings_show_pinned"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pref_show_pinned"
                android:textColor="@color/black"
                android:layout_marginBottom="8dp" />

            <CheckBox
                android:id="@+id/settings_show_nav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pref_show_nav"
                android:textColor="@color/black"
                android:layout_marginBottom="8dp" />

            <CheckBox
                android:id="@+id/settings_show_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pref_show_search"
                android:textColor="@color/black"
                android:layout_marginBottom="8dp" />

            <CheckBox
                android:id="@+id/settings_show_borders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pref_show_borders"
                android:textColor="@color/black"
                android:layout_marginBottom="8dp" />

            <CheckBox
                android:id="@+id/settings_volume_nav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pref_volume_nav"
                android:textColor="@color/black"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/pick_kiosk_btn"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/pick_kiosk_app"
                    android:background="@color/white"
                    android:textColor="@color/black"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/pick_font_btn"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/pick_font"
                    android:background="@color/white"
                    android:textColor="@color/black"
                    android:layout_marginStart="4dp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pref_gestures_title"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_gesture_page_triple"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_border_rect"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btn_gesture_prev_long"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_border_rect"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btn_gesture_next_long"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_border_rect"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btn_gesture_time_long"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_border_rect"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btn_gesture_settings_long"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_border_rect"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:layout_marginBottom="24dp" />

        </LinearLayout>

    </ScrollView>

    <!-- ── Tab 2: Lock Screen Settings ─────────────────────────────── -->
    <ScrollView
        android:id="@+id/tab_lockscreen_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="@color/white"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <CheckBox
                android:id="@+id/settings_enable_lockscreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable E-Ink Lock Screen on Wake"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <!-- Security PIN Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SECURITY &amp; PIN"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/lock_pin_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status: Swipe / Tap to Unlock (No PIN)"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btn_set_pin"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Set 4-Digit PIN..."
                android:background="@drawable/bg_border_rect"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:layout_marginBottom="14dp" />

            <!-- Display Layout Mode Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LOCK SCREEN CONTENT"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="6dp" />

            <RadioGroup
                android:id="@+id/rg_lock_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="14dp">

                <RadioButton
                    android:id="@+id/rb_mode_full"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Full Mode (Quotes + Owner Info + Clock)"
                    android:textSize="12sp"
                    android:textColor="@color/black" />

                <RadioButton
                    android:id="@+id/rb_mode_quote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Quote Only (Rotating Quotes + Clock)"
                    android:textSize="12sp"
                    android:textColor="@color/black" />

                <RadioButton
                    android:id="@+id/rb_mode_owner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Owner Only (Owner Contact Info + Clock)"
                    android:textSize="12sp"
                    android:textColor="@color/black" />

                <RadioButton
                    android:id="@+id/rb_mode_clock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Minimalist (Clock + Battery Only)"
                    android:textSize="12sp"
                    android:textColor="@color/black" />

            </RadioGroup>

            <!-- Owner Info Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OWNER &amp; RECOVERY INFO"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/owner_info_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No owner info set"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btn_edit_owner_info"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Edit Owner &amp; Contact Details..."
                android:background="@drawable/bg_border_rect"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:layout_marginBottom="14dp" />

            <!-- Quotes Library Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LITERARY &amp; PHILOSOPHY QUOTES"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/quotes_count_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Library: 40 Quotes (shuffled on each wake)"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btn_manage_quotes"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Browse &amp; Manage Quotes List..."
                android:background="@drawable/bg_border_rect"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btn_add_quote"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="+ Add Custom Quote..."
                android:background="@drawable/bg_border_rect"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btn_reset_quotes"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Reset to 40 Curated Quotes"
                android:background="@color/white"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:layout_marginBottom="24dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
