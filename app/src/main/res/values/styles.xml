<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AnyHomeTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:background">@color/white</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/black</item>
        <item name="android:buttonStyle">@style/AnyHomeButton</item>
        <item name="android:editTextStyle">@style/AnyHomeEditText</item>
    </style>

    <style name="AnyHomeButton" parent="@android:style/Widget.DeviceDefault.Button">
        <item name="android:background">@color/white</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="AnyHomeEditText" parent="@android:style/Widget.DeviceDefault.EditText">
        <item name="android:background">@color/white</item>
        <item name="android:textColor">@color/black</item>
    </style>
</resources>
